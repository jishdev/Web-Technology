# ---- Server ----
NODE_ENV=development
PORT=5000
# Set to 1 when running behind a reverse proxy (Nginx, Render, Railway, ...)
TRUST_PROXY=0

# ---- MongoDB ----
# Local:  mongodb://127.0.0.1:27017/hash27
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/hash27?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/hash27

# ---- Auth ----
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# REQUIRED (min 32 chars) when NODE_ENV=production
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=8h

# First admin, created by `npm run seed`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe@2027

# ---- CORS ----
# Comma-separated list of frontend origins allowed to call the API
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Uploads ----
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ---- Misc ----
# Set to true for load tests / automated runs (disables rate limiting)
RATE_LIMIT_DISABLED=false
