{
  "name": "hash27-backend",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for HASH '27 TechFest (MBCET) - Express + MongoDB",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "seed:reset": "node scripts/seed.js --reset",
    "postman": "newman run postman/HASH27.postman_collection.json -e postman/HASH27.local.postman_environment.json --working-dir postman",
    "admin:create": "node scripts/create-admin.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.4",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "newman": "^6.2.2"
  }
}
