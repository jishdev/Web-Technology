# Base URL of the backend API.
# Leave EMPTY in development: Vite proxies /api and /uploads to http://localhost:5000.
# Set it when the API is hosted elsewhere, e.g. https://api.yourdomain.com  (no trailing slash)
VITE_API_URL=

# Optional: point the dev proxy at a different backend port/host
# VITE_DEV_API_TARGET=http://localhost:5000
